{
  "swagger": "2.0",
  "info": {
    "title": "MaPS Beta Access Control",
    "description": "This service allows creation and verification of secure beta links for use on the MHPD",
    "contact": {
      "name": "General Enquires",
      "url": "https://maps.org.uk/en/about-us/contact-us",
      "email": "contact@maps.org.uk"
    },
    "license": {
      "name": "Government API License",
      "url": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
    },
    "version": "1.0"
  },
  "host": "localhost:7444",
  "schemes": [
    "http"
  ],
  "paths": {
    "/questionnaire-submission": {
      "post": {
        "tags": [
          "QuestionnaireSubmissionFunction"
        ],
        "summary": "Submit a completed participant questionnaire",
        "description": "Dashboard backend only. Requires a server-held function key. Returns no token or cookie. No onboarding capacity check is performed.",
        "operationId": "post-questionnaire-submission",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-functions-key",
            "description": "Function key held by the dashboard backend.",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QuestionnaireSubmission"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Questionnaire persisted. Empty response."
          },
          "403": {
            "description": "Submission could not be validated or persisted. Empty response."
          },
          "401": {
            "description": "Missing or invalid function key; rejected by the Functions host."
          }
        }
      }
    },
    "/send-code": {
      "get": {
        "tags": [
          "BetaAccessFunction"
        ],
        "summary": "GET Send Code to participant. Code required for verification",
        "description": "Sends a code to the participant via email that they can then use to verify the link belongs to them.",
        "operationId": "get-send-code",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "linkId",
            "description": "The link id you would like to send the verification code for.",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/verify-code": {
      "get": {
        "tags": [
          "BetaAccessFunction"
        ],
        "summary": "GET Verify Code from participant and issue token if valid",
        "description": "Verifies the code against the one sent to the participant and issues a new token if valid.",
        "operationId": "get-verify-code",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "linkId",
            "description": "The link id you would like to verify the code for",
            "type": "string"
          },
          {
            "in": "query",
            "name": "code",
            "description": "The code that was sent to the participants email by the send-code endpoint",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/VerifyCodeResponse"
            }
          }
        }
      }
    },
    "/validate": {
      "get": {
        "tags": [
          "BetaAccessFunction"
        ],
        "summary": "GET Validate existing token",
        "description": "Validates an existing token to ensure its well formed and within the validation period",
        "operationId": "get-validate",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "description": "The token to validate",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "definitions": {
    "QuestionnaireSubmission": {
      "type": "object",
      "required": [
        "answers",
        "consent",
        "locale",
        "personalDetails",
        "questionnaireVersion"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "en",
            "cy"
          ]
        },
        "questionnaireVersion": {
          "type": "string",
          "description": "Nonblank version supplied by the dashboard and stored as submitted.",
          "minLength": 1
        },
        "personalDetails": {
          "$ref": "#/definitions/ParticipantPersonalDetails"
        },
        "answers": {
          "$ref": "#/definitions/QuestionnaireAnswers"
        },
        "consent": {
          "$ref": "#/definitions/ParticipantConsent"
        }
      },
      "additionalProperties": false
    },
    "IActionResult": {
      "type": "object",
      "additionalProperties": false
    },
    "VerifyCodeResponse": {
      "type": "object",
      "properties": {
        "responseCode": {
          "type": "integer",
          "format": "int32"
        },
        "token": {
          "type": "string",
          "x-nullable": true
        }
      },
      "additionalProperties": false
    },
    "ParticipantConsent": {
      "type": "object",
      "required": [
        "decision",
        "timestamp",
        "version"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "agreed"
          ]
        },
        "version": {
          "type": "string",
          "description": "Nonblank consent version supplied by the dashboard and stored as submitted.",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 UTC timestamp with Z or +00:00.",
          "format": "date-time",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ParticipantPersonalDetails": {
      "type": "object",
      "required": [
        "emailAddress",
        "firstName",
        "lastName"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 1
        },
        "lastName": {
          "type": "string",
          "minLength": 1
        },
        "emailAddress": {
          "type": "string",
          "format": "email",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "QuestionnaireAnswers": {
      "type": "object",
      "required": [
        "ageRange",
        "healthConditions",
        "whereYouLive",
        "yourSex"
      ],
      "properties": {
        "ageRange": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "18-24",
            "25-34",
            "35-49",
            "50-64",
            "65-74",
            "75+",
            "prefer-not-to-say"
          ]
        },
        "whereYouLive": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "england",
            "scotland",
            "wales",
            "northern-ireland",
            "not-in-uk",
            "prefer-not-to-say"
          ]
        },
        "yourSex": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "male",
            "female",
            "other",
            "prefer-not-to-say"
          ]
        },
        "otherSex": {
          "type": "string",
          "description": "Required and nonblank when yourSex is other; otherwise omit or use an empty string.",
          "x-nullable": true
        },
        "healthConditions": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "yes",
            "no",
            "prefer-not-to-say"
          ]
        },
        "healthConditionsImpact": {
          "type": "string",
          "description": "Required and nonempty when healthConditions is yes; otherwise omit or use an empty string.",
          "enum": [
            "",
            "no",
            "yes",
            "yes-little",
            "prefer-not-to-say"
          ],
          "x-nullable": true
        }
      },
      "additionalProperties": false
    }
  },
  "tags": [
    {
      "name": "QuestionnaireSubmissionFunction"
    },
    {
      "name": "BetaAccessFunction"
    }
  ]
}
